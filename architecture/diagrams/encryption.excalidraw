      "isDeleted": false,
      "boundElements": [],
      "updated": 1785185046236,
      "link": null,
      "locked": false,
      "text": "Runs when a grant message is pushed to\nthe daemon from CP. Usually triggered on\neach re-connect, after authenticate",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Runs when a grant message is pushed to the daemon from CP. Usually triggered on each re-connect, after authenticate",
      "autoResize": false,
      "lineHeight": 1.25
    },
